{
  "name": "gatherup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/*.test.mts",
    "test:auth": "node --test tests/auth-rules.test.mts",
    "test:integration:rpc": "node --test tests/integration/rpc/*.test.mts",
    "test:schema": "node --test tests/schema-contract.test.mts",
    "verify": "npm run lint && npm test && npm run typecheck",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --project-id \"$GATHERUP_SUPABASE_PROJECT_REF\" --schema public > src/lib/supabase/database.types.ts",
    "cap:sync": "npx cap sync",
    "cap:copy:ios": "npx cap copy ios",
    "cap:open:ios": "npx cap open ios",
    "mobile:build": "NEXT_CAPACITOR_EXPORT=1 npm run build && npx cap sync",
    "ios:build": "NEXT_CAPACITOR_EXPORT=1 npm run build && npm run cap:sync && npm run cap:copy:ios",
    "ios:dev": "NEXT_CAPACITOR_EXPORT=1 next dev"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "7.1.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/camera": "8.2.2",
    "@capacitor/cli": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/device": "8.0.3",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/ios": "8.5.0",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.108.1",
    "exceljs": "4.4.0",
    "lucide-react": "1.16.0",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "6.18.0"
  },
  "overrides": {
    "postcss": "8.5.10",
    "sharp": "0.35.3",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.2.10",
    "@types/node": "25.8.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1"
  }
}
